{
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(date:*)",
      "Bash(jq:*)",
      "Bash(curl:*)",
      "Bash(rm:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(echo:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(wc:*)",
      "Read(*)",
      "Write(memory/*)",
      "Write(state/*)",
      "Write(logs/*)",
      "Write(reports/*)",
      "Write(alerts/*)"
