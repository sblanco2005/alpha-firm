{
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(date:*)",
      "Bash(jq:*)",
      "Bash(curl:*)",
      "Bash(rm:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(echo:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(wc:*)",
      "Read(*)",
      "Write(memory/*)",
      "Write(state/*)",
      "Write(logs/*)",
      "Write(reports/*)",
      "Write(alerts/*)"
    ],
    "deny": [
      "Write(agents/*)",
      "Write(skills/*)",
      "Write(CLAUDE.md)",
      "Write(orchestrator.md)"
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "mcpServers": {
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./memory",
        "./state",
        "./agents",
        "./skills",
        "./reports",
        "./alerts",
        "./logs"
      ]
    },
    "price-fetch": {
      "command": "/home/clawd/price-mcp/venv/bin/python3",
      "args": [
        "/home/clawd/price-mcp/price_server.py"
      ]
    },
    "finnhub": {
      "command": "/home/clawd/alpha-firm/mcp/venv/bin/python3",
      "args": [
        "/home/clawd/alpha-firm/mcp/finnhub_server.py"
      ],
      "env": {
        "FINNHUB_API_KEY": "d8u7c0pr01qinhug9jv0d8u7c0pr01qinhug9jvg"
      }
    }
  },
  "enableAllProjectMcpServers": true
}