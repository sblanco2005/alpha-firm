# Copy to .env.dashboard on the VPS (this .example is committed; .env.dashboard is git-ignored).
# Generate a token:  openssl rand -hex 32

# Require this bearer token on every /api route. Must match EXPO_PUBLIC_API_TOKEN in the app build.
API_TOKEN=replace-with-openssl-rand-hex-32

# Port the API listens on (default 3001).
PORT=3001

# Only needed if the finnhub key is NOT already in alpha-firm/.claude/settings.json on the VPS.
# FINNHUB_API_KEY=your-finnhub-key
